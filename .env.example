# 模型服务（必填）
model=deepseek-chat
base_url=https://api.deepseek.com/v1
api_key=

# 服务监听
host=127.0.0.1
port=8765
open_browser=true

# 模型行为
temperature=0.2
llm_timeout=600
stream=true
max_tool_rounds=45
mentor_rounds=15
plan_max_steps=8
step_max_retries=3

# 上下文管理
context_compress_ratio=0.8
tool_output_limit=200000

# 日志
log_level=INFO
